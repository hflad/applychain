__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Node
node_modules/

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Generated documents
*.docx
*.xlsx
*.pdf

