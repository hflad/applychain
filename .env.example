# ─────────────────────────────────────────────────────────────
# ApplyChain — Environment Variable Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER paste credentials into prompts, logs, or documents.
# ─────────────────────────────────────────────────────────────

# Claude API (if using API directly — not needed for Cowork/Claude Desktop)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LinkedIn credentials (used for job discovery automation, if enabled)
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# Other ATS credentials (add as needed — one per platform)
# WORKDAY_EMAIL=
# GREENHOUSE_EMAIL=
# LEVER_EMAIL=

# Notification settings (optional)
# NOTIFICATION_EMAIL=
# SLACK_WEBHOOK_URL=
