# ─────────────────────────────────────────────────────────────
# ApplyChain — Environment Variable Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# NEVER paste these values into a chat message or prompt.
# The agent reads credentials from this file at runtime.
# Your secrets stay on your machine. They never travel in prompts.
# ─────────────────────────────────────────────────────────────

# ── LLM API ───────────────────────────────────────────────────
# Only needed if using the API directly — not required for Claude Desktop / Cowork
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── ATS Account Credentials ───────────────────────────────────
# The agent uses these to log into and create accounts on ATS platforms
# (Workday, iCIMS, Taleo, Greenhouse, Lever, SuccessFactors, etc.)
#
# Password strategy — pick one:
#   A) Single shared password for all ATS accounts (simplest; fine for low-stakes portals)
#   B) Let Chrome generate a strong password at account creation time — Chrome saves it
#      to its password manager automatically and the agent proceeds without needing to know it
#   C) Custom rotation logic — keep it in a local script on your machine, never in this repo
#
ATS_EMAIL=you@example.com
ATS_PASSWORD=your-ats-password-here

# ── SSO Providers ─────────────────────────────────────────────
# The agent handles SSO by clicking "Sign in with Google/LinkedIn" directly.
# Works best when you're already signed into that provider in Chrome for the day
# and 2FA is not required. If a 2FA prompt appears, the agent will stop and ask you.
GOOGLE_EMAIL=you@gmail.com
LINKEDIN_EMAIL=you@example.com
# LINKEDIN_PASSWORD=  # only needed if SSO session has expired

# ── Notification Settings (optional) ──────────────────────────
# NOTIFICATION_EMAIL=you@example.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
